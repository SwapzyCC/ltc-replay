{
  "name": "ltc-replay",
  "version": "1.0.0",
  "description": "Durable ZMQ tap and replay service for a Litecoin Core node. Runs on the node VPS so consumers can restart without losing deposits.",
  "license": "BSD-3-Clause",
  "author": "Himanshu Singh",
  "homepage": "https://github.com/SwapzyCC/ltc-replay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwapzyCC/ltc-replay.git"
  },
  "bugs": {
    "url": "https://github.com/SwapzyCC/ltc-replay/issues"
  },
  "keywords": [
    "litecoin",
    "litecoin-core",
    "zeromq",
    "zmq",
    "blockchain",
    "deposits",
    "pruned-node",
    "replay",
    "sqlite",
    "typescript"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-sql.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "zeromq": "^6.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
