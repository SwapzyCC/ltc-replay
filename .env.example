# ltc-replay — configuration
#
# Copy to .env and fill in. Every value below is read once at boot and
# validated; anything required and missing is a startup failure, not a
# surprise later. An empty value counts as unset.

# ─── Litecoin Core JSON-RPC ───────────────────────────────────────────────────
# Used for catch-up (walking blocks the tap missed), for serving block contents
# on /v1/replay, and for confirmation counts on /v1/tx and /v1/address.
# Required. The relay only ever calls read methods.
#
# The scheme picks the transport, and the URI may carry the credentials:
#   http://host:port                     credentials in the settings below
#   http://user:password@host:port       credentials in the URI
#   https://user:password@host:port      the same through a TLS terminator
#
# A password containing @ : / or % must be percent-encoded
# (@ = %40, : = %3A, / = %2F, %% = %25). Litecoin Core's rpcauth generator
# emits $ freely, so this is the normal case rather than an edge one.
#
# The URI wins when both it and the separate settings carry credentials, and
# boot fails outright if the two disagree rather than guessing which is stale.
LTC_RPC_URL=http://127.0.0.1:9332
LTC_RPC_USER=
LTC_RPC_PASSWORD=
#   LTC_RPC_URL=https://rpcuser:PASSWORD@rpc.your-domain:9332

# Optional. Only needed if your node loads multiple wallets and the default
# endpoint is ambiguous; the relay itself uses no wallet methods.
LTC_RPC_WALLET=


# ─── Litecoin Core ZMQ (the live tap) ─────────────────────────────────────────
# Must match -zmqpubrawtx and -zmqpubhashblock in litecoin.conf, port for port.
#
# Note the ports: most guides show 28332 for hashtx and 28333 for hashblock,
# but rawtx is a *different* publisher and needs its own port. On the reference
# config in deploy/litecoin.conf.snippet that is 28334. Subscribing to the
# hashtx port instead delivers 32-byte hashes where the tap expects serialised
# transactions, and it will decode nothing.
#
# Keep these on loopback where you can: the relay usually runs on the same VPS
# as the node, and no network between Core and the tap means nothing to drop.
#
# The scheme picks the transport, and the URI may carry ZMQ PLAIN credentials:
#   tcp://host:port                  direct, unauthenticated
#   tcp://user:password@host:port    direct, ZMQ PLAIN
#   tls://user:password@host:port    ZMTP inside TLS, ZMQ PLAIN inside that
#
# A password containing @ : / or % must be percent-encoded
# (@ = %40, : = %3A, / = %2F, %% = %25).
#
# tls:// is for a publisher reached across the internet through a TLS
# terminator. It never silently degrades: a certificate that does not verify,
# or a name that does not match, drops the connection rather than continuing
# in the clear.
LTC_ZMQ_TX_URL=tcp://127.0.0.1:28334
LTC_ZMQ_BLOCK_URL=tcp://127.0.0.1:28333
#   LTC_ZMQ_TX_URL=tls://zmquser:PASSWORD@zmq.your-domain:28334
#   LTC_ZMQ_BLOCK_URL=tls://zmquser:PASSWORD@zmq.your-domain:28333


# ─── Republish socket (live fan-out to consumers) ─────────────────────────────
# The relay re-emits rawtx and hashblock verbatim on this PUB socket, so an
# existing Core ZMQ consumer works unchanged by pointing at this instead.
# Bind to the private interface the backend reaches you on, never 0.0.0.0 on a
# public VPS — ZMQ PUB has no authentication of its own.
PUB_BIND=tcp://127.0.0.1:28340


# ─── Replay HTTP API ──────────────────────────────────────────────────────────
# Defaults to loopback so a misconfigured deploy is unreachable rather than
# open. To serve the backend, bind to a private/VPN address and firewall it to
# the backend's IP.
HTTP_BIND=127.0.0.1
HTTP_PORT=28350

# Required — the service refuses to start without it. Sent by consumers as
# `Authorization: Bearer <token>`. Every route except /health needs it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOKEN=


# ─── Journal ──────────────────────────────────────────────────────────────────
# SQLite file holding the event log and the indexes. Block events are kept
# forever (a few dozen bytes each); mempool tx events are pruned on the
# retention below.
DB_PATH=./data/journal.sqlite

# How long raw mempool transactions stay replayable. Blocks are never pruned,
# and a missed deposit is recovered from blocks regardless, so this only needs
# to cover the window where you want unconfirmed sightings back too.
TX_RETENTION_HOURS=72

# How often to re-check the node tip against the journal and fill any gap.
# Also runs once at boot, which is what covers relay downtime.
CATCHUP_INTERVAL_MS=60000

# First-run floor. On an empty journal the relay starts here instead of
# walking the whole chain. Leave empty to start from the node's current tip.
START_HEIGHT=


# ─── Indexes ──────────────────────────────────────────────────────────────────
# These two exist because the node is pruned. `prune` and `txindex` are
# mutually exclusive in Core, so a pruned node can never answer
# getrawtransaction for a confirmed transaction that isn't its own wallet's —
# which is exactly the question "did this deposit confirm?" asks. The relay
# keeps its own answer instead.
#
# Depth of the txid → block index, in blocks below the tip. 0 disables it, and
# /v1/tx then only knows about transactions still in the event journal.
# 20000 blocks is roughly five weeks of Litecoin at 2.5 min/block. Whatever you
# set, it should comfortably exceed the longest gap you would ever want to
# answer for — including a deposit a user disputes weeks after the fact.
TX_INDEX_BLOCKS=20000

# Whether to decode each transaction's outputs and record which addresses were
# paid. This is what GET /v1/address/:address serves. Turning it off leaves the
# route answering an empty history rather than an error, so leave it on unless
# you only ever look transactions up by txid.
ADDRESS_INDEX=true


# ─── Watchlist ────────────────────────────────────────────────────────────────
# The largest single lever on disk, and it is on by default.
#
# On: a transaction is stored only if it pays an address registered through
# POST /v1/watch. Everything else is decoded, counted in tap.txFiltered, and
# dropped. A deposit monitor discards upwards of 99.9% of chain traffic that
# way, and the database ends up sized by your deposits rather than by Litecoin
# — tens of megabytes instead of gigabytes.
#
# Off: every addressable output on the chain is indexed. Right for a block
# explorer, or a relay serving consumers whose addresses it cannot know.
#
# Two things to know before leaving this on. An empty watchlist indexes nothing
# and looks perfectly healthy doing it, so alert on /v1/stats reporting
# watchlist.enabled=true with watchlist.count=0. And the list is the one part of
# this database the chain cannot rebuild — the consumer must re-push it after a
# rebuild, which the bundled client's syncWatched() does at boot.
WATCHLIST_ONLY=true

# Largest re-index one POST /v1/watch may request, in blocks below the tip.
# Only needed when an address might already have been paid — an import, or a
# registry that fell out of sync. Registering an address before publishing it
# never needs a rescan, so 0 is a reasonable setting if that is your flow.
# Bounded because an unbounded rescan is a way to make the relay walk the chain
# on request.
WATCH_RESCAN_MAX_BLOCKS=2000


# ─── Logging ──────────────────────────────────────────────────────────────────
# error | warn | info | debug. Anything unrecognised falls back to info.
LOG_LEVEL=info

# `json` emits one JSON object per line, for journald/Loki/CloudWatch ingest.
# Anything else stays human-readable. The Docker image defaults this to json.
LOG_FORMAT=
